# Base URL of the Go backend. Used by axios as baseURL and to build absolute
# media (avatar/image/video/voice/file) URLs. Leave blank to use relative paths
# (handy when the same host reverse-proxies /api and /uploads).
VITE_API_BASE_URL=http://localhost:8080

# WebSocket URL. If empty, it is derived from VITE_API_BASE_URL by swapping
# http(s) -> ws(s) and appending /ws.
VITE_WS_URL=

# Dev-only: the upstream the Vite dev server proxies /api, /uploads and /ws to.
# Use this when you want the browser to talk to the dev server (avoiding CORS)
# while the dev server forwards to your local backend.
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Server
PORT=8080
ENV=development

# PostgreSQL
# NOTE: when running via `docker compose up` (server/docker-compose.yml), the
# api/postgres/pgadmin containers read POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB
# from server/.env (copy this file to `.env` and set real values — compose
# refuses to start without POSTGRES_PASSWORD / PGADMIN_DEFAULT_PASSWORD set).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=telegramclone
DATABASE_URL=postgres://postgres:change-me-to-a-strong-password@localhost:5432/telegramclone?sslmode=disable
# Optional: max connections in the pgx pool (default 20). Min is 2, idle 5m, lifetime 30m.
DB_MAX_CONNS=20

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Set REDIS_TLS=true to connect over TLS (system CA trust).
REDIS_TLS=false

# JWT — required in production (ENV=production refuses to start without it).
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# SMTP (OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@telegramclone.local

# Uploads
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:8080

# Migrations — optional absolute/relative path. Falls back to ./migrations or ../migrations.
MIGRATIONS_DIR=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (auth endpoints)
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

# OTP
OTP_PEPPER=change-me-to-a-long-random-pepper-in-production
OTP_EXPIRY=10m
REGISTRATION_TTL=30m
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT=15m

# WebSocket
WS_PING_INTERVAL=30s
WS_READ_TIMEOUT=60s

# FCM — optional. When set, offline members receive push for new messages.
# Leave empty in local dev; the API still stores device tokens via POST /api/devices/push-token.
FCM_SERVER_KEY=

# pgAdmin (docker compose --profile tools) — only used by the pgadmin container.
PGADMIN_DEFAULT_EMAIL=admin@local.dev
PGADMIN_DEFAULT_PASSWORD=change-me-to-a-strong-password

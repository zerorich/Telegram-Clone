# Server
PORT=8080
ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegramclone?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# SMTP (OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@telegramclone.local

# Uploads
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:8080

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (auth endpoints)
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m

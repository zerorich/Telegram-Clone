# Server
PORT=8080
ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegramclone?sslmode=disable
# Optional: max connections in the pgx pool (default 20). Min is 2, idle 5m, lifetime 30m.
DB_MAX_CONNS=20

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
# Set REDIS_TLS=true to connect over TLS (system CA trust).
REDIS_TLS=false

# JWT — required in production (ENV=production refuses to start without it).
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# SMTP (OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@telegramclone.local

# Uploads
UPLOAD_DIR=./uploads
BASE_URL=http://localhost:8080

# Migrations — optional absolute/relative path. Falls back to ./migrations or ../migrations.
MIGRATIONS_DIR=

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limit (auth endpoints)
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW=1m
